# Build context hygiene: keep secrets, VCS data and host-only files out of the image.
node_modules
.next
*.tsbuildinfo
next-env.d.ts
.git
.github
scratch
test-langdock.ts
tsconfig.tsbuildinfo
vps_id_rsa
vps_id_rsa_backup
*.pem
*.key
id_rsa*
project.zip
assets
supabase
scripts

# Secrets never enter the build context. Runtime values come from compose
# `env_file`; public build-time values come from compose `build.args`.
.env
.env.*

# Host-only deployment files
Dockerfile
docker-compose.yml
deploy.sh
nginx
transcribe.py
supabase_email_template.html
*.md
